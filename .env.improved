# ============================================================================
# MULTI-AGENT APPOINTMENT BOOKING SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================================
# 
# SECURITY WARNING:
# - This file contains sensitive credentials and should NEVER be committed to Git
# - Verify .env is in .gitignore before adding any real credentials
# - Replace all placeholder values (user, password, your-*-key) with actual values
# - Use strong, unique passwords for production environments
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.improved .env
# 2. Replace 'user' with your PostgreSQL username
# 3. Update all API keys and secrets
# 4. Run: python scripts/check_db_health.py to verify database connection
# ============================================================================

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
APP_NAME=Multi-Agents-Appointment-Booking
APP_ENV=development
DEBUG=True

# Generate secure keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection URL format: postgresql://username:password@host:port/database
# 
# IMPORTANT: Replace 'user' with your actual PostgreSQL username
# Examples:
#   - Local development: postgresql://deshawnmackey:password@localhost:5432/appointment_booking
#   - Production with SSL: postgresql://user:pass@host:5432/db?sslmode=require
#
DATABASE_URL=postgresql://user:8fXGHOTEtX5FFL04YDk7d8QkHL66ksvK@localhost:5432/appointment_booking

# Connection Pool Configuration
# Adjust these values based on your application load and database capacity
#
# DATABASE_POOL_SIZE: Number of persistent database connections
#   - Development: 10-20
#   - Production (light load): 20-30
#   - Production (medium load): 30-50
#   - Production (heavy load): 50-100
DATABASE_POOL_SIZE=20

# DATABASE_POOL_MAX_OVERFLOW: Additional connections when pool is exhausted
#   - Allows temporary connections during traffic spikes
#   - Recommended: 10-20 for production
DATABASE_POOL_MAX_OVERFLOW=10

# DATABASE_POOL_TIMEOUT: Seconds to wait for available connection
#   - Prevents indefinite waiting
#   - Recommended: 30 seconds
DATABASE_POOL_TIMEOUT=30

# DATABASE_POOL_RECYCLE: Recycle connections after N seconds
#   - Prevents stale connections
#   - Recommended: 3600 (1 hour)
DATABASE_POOL_RECYCLE=3600

# DATABASE_ECHO_POOL: Log connection pool checkouts/checkins
#   - Useful for debugging connection issues
#   - Set to 'true' only when troubleshooting
DATABASE_ECHO_POOL=false

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# ============================================================================
# GOOGLE CALENDAR INTEGRATION
# ============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ============================================================================
# MICROSOFT GRAPH (OUTLOOK) INTEGRATION
# ============================================================================
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# ============================================================================
# SENDGRID (EMAIL) CONFIGURATION
# ============================================================================
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ============================================================================
# TWILIO (SMS) CONFIGURATION
# ============================================================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

# ============================================================================
# CELERY CONFIGURATION
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_RATE_LIMIT=100
API_TIMEOUT=30

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================================
# NOTES FOR PRODUCTION DEPLOYMENT
# ============================================================================
#
# 1. SECURITY:
#    - Set APP_ENV=production
#    - Set DEBUG=False
#    - Use SSL for database: ?sslmode=require or ?sslmode=verify-full
#    - Generate new SECRET_KEY and JWT_SECRET_KEY
#    - Use environment variables or secret management service
#
# 2. DATABASE:
#    - Increase DATABASE_POOL_SIZE based on load (50-100)
#    - Set DATABASE_POOL_MAX_OVERFLOW=20
#    - Enable connection encryption
#    - Use read replicas for scaling
#
# 3. MONITORING:
#    - Set LOG_LEVEL=WARNING or ERROR
#    - Enable application performance monitoring
#    - Set up database connection monitoring
#    - Configure alerts for pool exhaustion
#
# 4. BACKUP:
#    - Regular database backups
#    - Test restore procedures
#    - Document recovery process
#
# ============================================================================