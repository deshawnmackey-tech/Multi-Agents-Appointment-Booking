# Copy this file to .env and replace the placeholder values with your real credentials.
# The application reads settings from the local .env file at runtime.

# Application
APP_NAME=Multi-Agents-Appointment-Booking
APP_ENV=development
DEBUG=True
SECRET_KEY=

# Database Configuration
# PostgreSQL connection URL format: postgresql://username:password@host:port/database
# IMPORTANT: Replace 'user' and 'password' with your actual PostgreSQL credentials
# SECURITY: Never commit the actual .env file to version control
DATABASE_URL=postgresql://user:password@localhost:5432/appointment_booking

# Connection Pool Settings
# Adjust based on your application load and database capacity
DATABASE_POOL_SIZE=20
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO_POOL=false

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI (NLP Agent)
# Paste your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# Google Calendar (Google Agent)
# Paste values from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Microsoft Graph (Outlook Agent)
# Paste values from Azure App Registration: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# CalDAV (Apple/iOS Calendar Agent)
# Use your Apple ID email and an app-specific password for iCloud CalDAV
CALDAV_URL=https://caldav.icloud.com/
CALDAV_USERNAME=your-caldav-username
CALDAV_PASSWORD=your-caldav-password
CALDAV_CALENDAR_NAME=Calendar

# SendGrid (Email Notifications)
# Paste your API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Twilio (SMS/Voice Notifications)
# Paste values from https://console.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0